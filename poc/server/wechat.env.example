# Copy to poc/.runtime/wechat.env. Never commit the real file.
# Use a dedicated test Official Account, not a production account.
WECHAT_APP_ID=replace-with-test-app-id
WECHAT_APP_SECRET=replace-with-test-app-secret
# Optional: use an existing token instead of AppID/AppSecret.
# WECHAT_ACCESS_TOKEN=
# Optional: test/mock gateway only. Defaults to https://api.weixin.qq.com.
# WECHAT_API_BASE=https://api.weixin.qq.com
