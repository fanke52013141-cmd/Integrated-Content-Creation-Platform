{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated-content.local/schema/wechat-theme-1.json",
  "title": "Versioned WeChat theme",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "description", "tokens", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "tokens": { "type": "object" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "selectors", "declarations"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^#output(?:$|\\s)" }
          },
          "declarations": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": ["string", "number"] }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
