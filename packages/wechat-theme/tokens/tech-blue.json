{
  "$schema": "../schema/theme.schema.json",
  "schemaVersion": "1.0.0",
  "id": "tech-blue",
  "name": "科技蓝",
  "version": "1.0.0",
  "description": "以深海军蓝标题、青色信号线、浅蓝信息卡和深色代码台构成清晰的科技叙事。",
  "tokens": {
    "color": {
      "primary": "#175CD3",
      "primaryDark": "#0B3B75",
      "accent": "#08A8C7",
      "ink": "#15253D",
      "muted": "#52657D",
      "paper": "#F4F8FF",
      "surface": "#FFFFFF",
      "soft": "#E8F1FF",
      "border": "#B9D2F5",
      "codeBackground": "#0B1F3A",
      "codeText": "#DCEBFF",
      "highlight": "#CFF4FF",
      "white": "#FFFFFF"
    },
    "font": {
      "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "heading": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "mono": "Consolas, Monaco, 'Courier New', monospace"
    },
    "size": { "body": "16px", "small": "13px", "h1": "30px", "h2": "23px", "h3": "19px", "h4": "17px", "code": "13px" },
    "space": { "block": "26px", "tight": "12px", "gutter": "8px", "card": "18px" },
    "radius": { "small": "4px", "medium": "8px", "large": "14px" },
    "line": { "body": "1.85", "heading": "1.4", "code": "1.7" },
    "tracking": { "body": "0.02em", "title": "0.04em" },
    "shadow": { "card": "0 6px 18px rgba(23, 92, 211, 0.10)" }
  },
  "rules": [
    { "name": "root", "selectors": ["#output"], "declarations": { "background-color": "{color.paper}", "color": "{color.ink}", "font-family": "{font.body}", "font-size": "{size.body}", "letter-spacing": "{tracking.body}", "line-height": "{line.body}", "padding": "4px 0" } },
    { "name": "heading-one", "selectors": ["#output h1"], "declarations": { "background-color": "{color.primaryDark}", "border-bottom": "4px solid {color.accent}", "border-radius": "{radius.medium}", "box-shadow": "{shadow.card}", "color": "{color.white}", "font-family": "{font.heading}", "font-size": "{size.h1}", "font-weight": "700", "letter-spacing": "{tracking.title}", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter}", "padding": "{space.card}", "text-align": "left" } },
    { "name": "heading-two", "selectors": ["#output h2"], "declarations": { "background-color": "{color.primary}", "border-bottom": "2px solid {color.primaryDark}", "border-left": "6px solid {color.accent}", "border-radius": "{radius.small}", "color": "{color.white}", "font-family": "{font.heading}", "font-size": "{size.h2}", "font-weight": "700", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding": "{space.tight} {space.card}" } },
    { "name": "heading-three", "selectors": ["#output h3"], "declarations": { "background-color": "{color.soft}", "border-left": "4px solid {color.primary}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h3}", "font-weight": "700", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding": "10px {space.tight}" } },
    { "name": "heading-minor", "selectors": ["#output h4", "#output h5", "#output h6"], "declarations": { "border-bottom": "1px solid {color.border}", "color": "{color.primary}", "font-family": "{font.heading}", "font-size": "{size.h4}", "font-weight": "700", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding-bottom": "6px" } },
    { "name": "paragraph", "selectors": ["#output p"], "declarations": { "color": "{color.ink}", "font-family": "{font.body}", "letter-spacing": "{tracking.body}", "line-height": "{line.body}", "margin": "0 {space.gutter} {space.block}" } },
    { "name": "link", "selectors": ["#output a"], "declarations": { "color": "{color.primaryDark}", "font-weight": "600", "text-decoration": "underline", "text-decoration-color": "{color.accent}", "text-underline-offset": "3px" } },
    { "name": "strong", "selectors": ["#output strong"], "declarations": { "background-color": "{color.soft}", "color": "{color.primaryDark}", "font-weight": "700", "padding": "0 2px" } },
    { "name": "emphasis", "selectors": ["#output em"], "declarations": { "color": "{color.muted}", "font-style": "italic" } },
    { "name": "deleted", "selectors": ["#output del", "#output .del"], "declarations": { "color": "{color.muted}", "text-decoration": "line-through" } },
    { "name": "blockquote", "selectors": ["#output blockquote"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.border}", "border-left": "5px solid {color.primary}", "border-radius": "{radius.medium}", "box-shadow": "{shadow.card}", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "blockquote-text", "selectors": ["#output blockquote p"], "declarations": { "color": "{color.muted}", "line-height": "{line.body}", "margin": "0" } },
    { "name": "callout", "selectors": ["#output .markdown-alert", "#output .wechat-callout"], "declarations": { "background-color": "{color.soft}", "border-left": "4px solid {color.accent}", "border-radius": "{radius.small}", "display": "block", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "callout-title", "selectors": ["#output .alert-title", "#output .markdown-alert-title", "#output .wechat-card-title"], "declarations": { "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-weight": "700", "margin-bottom": "{space.tight}" } },
    { "name": "lists", "selectors": ["#output ul", "#output ol"], "declarations": { "color": "{color.ink}", "line-height": "{line.body}", "margin": "0 {space.gutter} {space.block}", "padding-left": "26px" } },
    { "name": "list-item", "selectors": ["#output li"], "declarations": { "margin": "6px 0", "padding-left": "4px" } },
    { "name": "table", "selectors": ["#output table"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.border}", "border-collapse": "collapse", "color": "{color.ink}", "font-size": "{size.small}", "margin": "{space.block} 0", "width": "100%" } },
    { "name": "table-head", "selectors": ["#output thead"], "declarations": { "background-color": "{color.primaryDark}", "color": "{color.white}" } },
    { "name": "table-header-cell", "selectors": ["#output th"], "declarations": { "background-color": "{color.primaryDark}", "border": "1px solid {color.primaryDark}", "color": "{color.white}", "font-family": "{font.heading}", "font-weight": "700", "line-height": "1.5", "padding": "{space.tight}", "text-align": "left" } },
    { "name": "table-cell", "selectors": ["#output td"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.border}", "line-height": "1.6", "padding": "{space.tight}", "vertical-align": "top" } },
    { "name": "table-alt-row", "selectors": ["#output tbody tr:nth-child(even) td"], "declarations": { "background-color": "{color.soft}" } },
    { "name": "code-block", "selectors": ["#output pre", "#output pre.code__pre", "#output .code-block"], "declarations": { "background-color": "{color.codeBackground}", "border-left": "5px solid {color.accent}", "border-radius": "{radius.medium}", "color": "{color.codeText}", "font-family": "{font.mono}", "font-size": "{size.code}", "line-height": "{line.code}", "margin": "{space.block} {space.gutter}", "overflow-wrap": "anywhere", "padding": "{space.card}", "white-space": "pre-wrap", "word-break": "break-word" } },
    { "name": "code-block-inner", "selectors": ["#output pre code", "#output pre.code__pre code"], "declarations": { "background-color": "transparent", "border": "0", "color": "inherit", "display": "block", "font-family": "{font.mono}", "margin": "0", "padding": "0", "white-space": "inherit" } },
    { "name": "code-inline", "selectors": ["#output code", "#output .codespan", "#output .code-inline"], "declarations": { "background-color": "{color.soft}", "border": "1px solid {color.border}", "border-radius": "{radius.small}", "color": "{color.primaryDark}", "font-family": "{font.mono}", "font-size": "{size.code}", "padding": "2px 5px" } },
    { "name": "image", "selectors": ["#output img"], "declarations": { "border": "1px solid {color.border}", "border-radius": "{radius.medium}", "box-shadow": "{shadow.card}", "display": "block", "height": "auto", "margin": "{space.block} auto", "max-width": "100%" } },
    { "name": "figure", "selectors": ["#output figure"], "declarations": { "margin": "{space.block} {space.gutter}", "padding": "0" } },
    { "name": "figcaption", "selectors": ["#output figcaption", "#output .md-figcaption"], "declarations": { "color": "{color.muted}", "font-size": "{size.small}", "line-height": "1.5", "margin-top": "8px", "text-align": "center" } },
    { "name": "divider", "selectors": ["#output hr"], "declarations": { "background-color": "transparent", "border": "0", "border-top": "2px solid {color.primary}", "height": "0", "margin": "{space.block} {space.gutter}" } },
    { "name": "card", "selectors": ["#output .wechat-card"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.border}", "border-radius": "{radius.large}", "border-top": "4px solid {color.accent}", "box-shadow": "{shadow.card}", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "card-title", "selectors": ["#output .wechat-card-title"], "declarations": { "border-bottom": "1px solid {color.border}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h3}", "font-weight": "700", "margin-bottom": "{space.tight}", "padding-bottom": "{space.tight}" } },
    { "name": "note", "selectors": ["#output .wechat-note", "#output .footnotes"], "declarations": { "background-color": "{color.soft}", "border": "1px dashed {color.border}", "border-radius": "{radius.small}", "color": "{color.muted}", "font-size": "{size.small}", "line-height": "1.6", "margin": "{space.block} {space.gutter}", "padding": "{space.tight}" } },
    { "name": "highlight", "selectors": ["#output mark", "#output .markup-highlight"], "declarations": { "background-color": "{color.highlight}", "border-radius": "{radius.small}", "color": "{color.primaryDark}", "font-weight": "700", "padding": "2px 4px" } },
    { "name": "underline", "selectors": ["#output .markup-underline"], "declarations": { "color": "{color.primaryDark}", "text-decoration": "underline", "text-decoration-color": "{color.primary}", "text-underline-offset": "3px" } }
  ]
}
