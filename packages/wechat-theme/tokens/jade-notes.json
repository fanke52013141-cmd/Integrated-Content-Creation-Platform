{
  "$schema": "../schema/theme.schema.json",
  "schemaVersion": "1.0.0",
  "id": "jade-notes",
  "name": "翡翠笔记",
  "version": "1.0.0",
  "description": "以翡翠边线、嫩叶色标记、圆角手账卡和琥珀注释构建温润而有层次的阅读体验。",
  "tokens": {
    "color": {
      "primary": "#0D8A6A",
      "primaryDark": "#075A47",
      "accent": "#C79A2B",
      "ink": "#183B33",
      "muted": "#58736A",
      "paper": "#F2F8F4",
      "surface": "#FFFFFF",
      "soft": "#E3F3EA",
      "border": "#BFE0D2",
      "codeBackground": "#103A32",
      "codeText": "#DDF5E9",
      "highlight": "#E6F2B8",
      "white": "#FFFFFF"
    },
    "font": {
      "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "heading": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "mono": "Consolas, Monaco, 'Courier New', monospace"
    },
    "size": { "body": "16px", "small": "13px", "h1": "29px", "h2": "22px", "h3": "19px", "h4": "17px", "code": "13px" },
    "space": { "block": "26px", "tight": "12px", "gutter": "8px", "card": "19px" },
    "radius": { "small": "6px", "medium": "10px", "large": "16px" },
    "line": { "body": "1.85", "heading": "1.45", "code": "1.7" },
    "tracking": { "body": "0.02em", "title": "0.03em" },
    "shadow": { "card": "0 5px 16px rgba(13, 138, 106, 0.09)" }
  },
  "rules": [
    { "name": "root", "selectors": ["#output"], "declarations": { "background-color": "{color.paper}", "color": "{color.ink}", "font-family": "{font.body}", "font-size": "{size.body}", "letter-spacing": "{tracking.body}", "line-height": "{line.body}", "padding": "5px 0" } },
    { "name": "heading-one", "selectors": ["#output h1"], "declarations": { "background-color": "{color.surface}", "border-bottom": "2px solid {color.primary}", "border-left": "8px solid {color.primaryDark}", "border-radius": "{radius.large}", "border-top": "2px solid {color.primary}", "box-shadow": "{shadow.card}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h1}", "font-weight": "700", "letter-spacing": "{tracking.title}", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter}", "padding": "{space.card}", "text-align": "left" } },
    { "name": "heading-two", "selectors": ["#output h2"], "declarations": { "background-color": "{color.soft}", "border": "1px solid {color.primary}", "border-left": "6px solid {color.accent}", "border-radius": "{radius.large}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h2}", "font-weight": "700", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding": "12px {space.card}" } },
    { "name": "heading-three", "selectors": ["#output h3"], "declarations": { "background-color": "{color.surface}", "border-bottom": "2px dashed {color.accent}", "border-left": "4px solid {color.primary}", "color": "{color.primary}", "font-family": "{font.heading}", "font-size": "{size.h3}", "font-weight": "700", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding": "9px {space.tight}" } },
    { "name": "heading-minor", "selectors": ["#output h4", "#output h5", "#output h6"], "declarations": { "border-bottom": "1px solid {color.border}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h4}", "font-weight": "700", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding-bottom": "6px" } },
    { "name": "paragraph", "selectors": ["#output p"], "declarations": { "color": "{color.ink}", "font-family": "{font.body}", "letter-spacing": "{tracking.body}", "line-height": "{line.body}", "margin": "0 {space.gutter} {space.block}" } },
    { "name": "link", "selectors": ["#output a"], "declarations": { "color": "{color.primaryDark}", "font-weight": "600", "text-decoration": "underline", "text-decoration-color": "{color.accent}", "text-underline-offset": "4px" } },
    { "name": "strong", "selectors": ["#output strong"], "declarations": { "background-color": "{color.soft}", "border-radius": "{radius.small}", "color": "{color.primaryDark}", "font-weight": "700", "padding": "0 3px" } },
    { "name": "emphasis", "selectors": ["#output em"], "declarations": { "color": "{color.primary}", "font-style": "italic" } },
    { "name": "deleted", "selectors": ["#output del", "#output .del"], "declarations": { "color": "{color.muted}", "text-decoration": "line-through" } },
    { "name": "blockquote", "selectors": ["#output blockquote"], "declarations": { "background-color": "{color.soft}", "border": "2px dashed {color.primary}", "border-radius": "{radius.large}", "box-shadow": "{shadow.card}", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "blockquote-text", "selectors": ["#output blockquote p"], "declarations": { "color": "{color.muted}", "line-height": "{line.body}", "margin": "0" } },
    { "name": "callout", "selectors": ["#output .markdown-alert", "#output .wechat-callout"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.border}", "border-left": "5px solid {color.accent}", "border-radius": "{radius.medium}", "display": "block", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "callout-title", "selectors": ["#output .alert-title", "#output .markdown-alert-title", "#output .wechat-card-title"], "declarations": { "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-weight": "700", "margin-bottom": "{space.tight}" } },
    { "name": "lists", "selectors": ["#output ul", "#output ol"], "declarations": { "color": "{color.ink}", "line-height": "{line.body}", "margin": "0 {space.gutter} {space.block}", "padding-left": "27px" } },
    { "name": "list-item", "selectors": ["#output li"], "declarations": { "border-bottom": "1px dotted {color.border}", "margin": "6px 0", "padding": "0 0 6px 4px" } },
    { "name": "table", "selectors": ["#output table"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.primary}", "border-collapse": "collapse", "color": "{color.ink}", "font-size": "{size.small}", "margin": "{space.block} 0", "width": "100%" } },
    { "name": "table-head", "selectors": ["#output thead"], "declarations": { "background-color": "{color.primary}", "color": "{color.white}" } },
    { "name": "table-header-cell", "selectors": ["#output th"], "declarations": { "background-color": "{color.primary}", "border": "1px solid {color.primaryDark}", "color": "{color.white}", "font-family": "{font.heading}", "font-weight": "700", "line-height": "1.5", "padding": "{space.tight}", "text-align": "left" } },
    { "name": "table-cell", "selectors": ["#output td"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.border}", "line-height": "1.6", "padding": "{space.tight}", "vertical-align": "top" } },
    { "name": "table-alt-row", "selectors": ["#output tbody tr:nth-child(even) td"], "declarations": { "background-color": "{color.soft}" } },
    { "name": "code-block", "selectors": ["#output pre", "#output pre.code__pre", "#output .code-block"], "declarations": { "background-color": "{color.codeBackground}", "border-left": "5px solid {color.accent}", "border-radius": "{radius.medium}", "color": "{color.codeText}", "font-family": "{font.mono}", "font-size": "{size.code}", "line-height": "{line.code}", "margin": "{space.block} {space.gutter}", "overflow-wrap": "anywhere", "padding": "{space.card}", "white-space": "pre-wrap", "word-break": "break-word" } },
    { "name": "code-block-inner", "selectors": ["#output pre code", "#output pre.code__pre code"], "declarations": { "background-color": "transparent", "border": "0", "color": "inherit", "display": "block", "font-family": "{font.mono}", "margin": "0", "padding": "0", "white-space": "inherit" } },
    { "name": "code-inline", "selectors": ["#output code", "#output .codespan", "#output .code-inline"], "declarations": { "background-color": "{color.soft}", "border": "1px solid {color.border}", "border-radius": "{radius.small}", "color": "{color.primaryDark}", "font-family": "{font.mono}", "font-size": "{size.code}", "padding": "2px 5px" } },
    { "name": "image", "selectors": ["#output img"], "declarations": { "border": "1px solid {color.border}", "border-radius": "{radius.large}", "box-shadow": "{shadow.card}", "display": "block", "height": "auto", "margin": "{space.block} auto", "max-width": "100%" } },
    { "name": "figure", "selectors": ["#output figure"], "declarations": { "background-color": "{color.surface}", "border-radius": "{radius.medium}", "margin": "{space.block} {space.gutter}", "padding": "{space.tight}" } },
    { "name": "figcaption", "selectors": ["#output figcaption", "#output .md-figcaption"], "declarations": { "color": "{color.muted}", "font-size": "{size.small}", "line-height": "1.5", "margin-top": "8px", "text-align": "center" } },
    { "name": "divider", "selectors": ["#output hr"], "declarations": { "background-color": "transparent", "border": "0", "border-top": "2px dashed {color.primary}", "height": "0", "margin": "{space.block} {space.gutter}" } },
    { "name": "card", "selectors": ["#output .wechat-card"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.border}", "border-left": "6px solid {color.accent}", "border-radius": "{radius.large}", "box-shadow": "{shadow.card}", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "card-title", "selectors": ["#output .wechat-card-title"], "declarations": { "border-bottom": "1px dashed {color.primary}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h3}", "font-weight": "700", "margin-bottom": "{space.tight}", "padding-bottom": "{space.tight}" } },
    { "name": "note", "selectors": ["#output .wechat-note", "#output .footnotes"], "declarations": { "background-color": "{color.soft}", "border": "1px dashed {color.accent}", "border-radius": "{radius.medium}", "color": "{color.muted}", "font-size": "{size.small}", "line-height": "1.65", "margin": "{space.block} {space.gutter}", "padding": "{space.tight}" } },
    { "name": "highlight", "selectors": ["#output mark", "#output .markup-highlight"], "declarations": { "background-color": "{color.highlight}", "border-radius": "{radius.small}", "color": "{color.primaryDark}", "font-weight": "700", "padding": "2px 4px" } },
    { "name": "underline", "selectors": ["#output .markup-underline"], "declarations": { "color": "{color.primaryDark}", "text-decoration": "underline", "text-decoration-color": "{color.accent}", "text-underline-offset": "4px" } }
  ]
}
