{
  "$schema": "../schema/theme.schema.json",
  "schemaVersion": "1.0.0",
  "id": "editorial-red",
  "name": "编辑红",
  "version": "1.0.0",
  "description": "用朱砂刊头、暖纸底色、金色书腰线与衬线标题形成有节奏的杂志编辑风格。",
  "tokens": {
    "color": {
      "primary": "#C63C35",
      "primaryDark": "#7D211C",
      "accent": "#B8892D",
      "ink": "#2C2421",
      "muted": "#766A64",
      "paper": "#FBF7F0",
      "surface": "#FFFEFB",
      "soft": "#F5E9DF",
      "border": "#E4C9C2",
      "codeBackground": "#2B2424",
      "codeText": "#F8E8DF",
      "highlight": "#F4DFA8",
      "white": "#FFFFFF"
    },
    "font": {
      "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "heading": "'Songti SC', 'STSong', 'SimSun', serif",
      "mono": "Consolas, Monaco, 'Courier New', monospace"
    },
    "size": { "body": "16px", "small": "13px", "h1": "32px", "h2": "24px", "h3": "20px", "h4": "17px", "code": "13px" },
    "space": { "block": "28px", "tight": "12px", "gutter": "10px", "card": "20px" },
    "radius": { "small": "2px", "medium": "4px", "large": "6px" },
    "line": { "body": "1.9", "heading": "1.45", "code": "1.75" },
    "tracking": { "body": "0.03em", "title": "0.12em" },
    "shadow": { "card": "0 4px 12px rgba(125, 33, 28, 0.07)" }
  },
  "rules": [
    { "name": "root", "selectors": ["#output"], "declarations": { "background-color": "{color.paper}", "color": "{color.ink}", "font-family": "{font.body}", "font-size": "{size.body}", "letter-spacing": "{tracking.body}", "line-height": "{line.body}", "padding": "6px 0" } },
    { "name": "heading-one", "selectors": ["#output h1"], "declarations": { "background-color": "{color.surface}", "border-bottom": "4px double {color.primary}", "border-top": "4px double {color.primary}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h1}", "font-weight": "700", "letter-spacing": "{tracking.title}", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter}", "padding": "{space.card} {space.tight}", "text-align": "center" } },
    { "name": "heading-two", "selectors": ["#output h2"], "declarations": { "background-color": "{color.primary}", "border-bottom": "3px solid {color.accent}", "border-radius": "{radius.small}", "color": "{color.white}", "font-family": "{font.heading}", "font-size": "{size.h2}", "font-weight": "700", "letter-spacing": "0.06em", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding": "10px {space.card}", "text-align": "center" } },
    { "name": "heading-three", "selectors": ["#output h3"], "declarations": { "background-color": "{color.soft}", "border-left": "6px solid {color.primary}", "border-bottom": "1px solid {color.accent}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h3}", "font-weight": "700", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding": "10px {space.tight}" } },
    { "name": "heading-minor", "selectors": ["#output h4", "#output h5", "#output h6"], "declarations": { "border-bottom": "1px dotted {color.primary}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h4}", "font-weight": "700", "line-height": "{line.heading}", "margin": "{space.block} {space.gutter} {space.tight}", "padding-bottom": "7px" } },
    { "name": "paragraph", "selectors": ["#output p"], "declarations": { "color": "{color.ink}", "font-family": "{font.body}", "letter-spacing": "{tracking.body}", "line-height": "{line.body}", "margin": "0 {space.gutter} {space.block}" } },
    { "name": "link", "selectors": ["#output a"], "declarations": { "border-bottom": "1px solid {color.accent}", "color": "{color.primaryDark}", "font-weight": "600", "text-decoration": "none" } },
    { "name": "strong", "selectors": ["#output strong"], "declarations": { "border-bottom": "2px solid {color.accent}", "color": "{color.primaryDark}", "font-weight": "700", "padding": "0 2px" } },
    { "name": "emphasis", "selectors": ["#output em"], "declarations": { "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-style": "italic" } },
    { "name": "deleted", "selectors": ["#output del", "#output .del"], "declarations": { "color": "{color.muted}", "text-decoration": "line-through" } },
    { "name": "blockquote", "selectors": ["#output blockquote"], "declarations": { "background-color": "{color.soft}", "border": "1px solid {color.border}", "border-left": "8px solid {color.primary}", "border-radius": "{radius.medium}", "box-shadow": "{shadow.card}", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "blockquote-text", "selectors": ["#output blockquote p"], "declarations": { "color": "{color.muted}", "font-family": "{font.heading}", "line-height": "{line.body}", "margin": "0" } },
    { "name": "callout", "selectors": ["#output .markdown-alert", "#output .wechat-callout"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.accent}", "border-left": "4px solid {color.accent}", "border-radius": "{radius.small}", "display": "block", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "callout-title", "selectors": ["#output .alert-title", "#output .markdown-alert-title", "#output .wechat-card-title"], "declarations": { "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-weight": "700", "letter-spacing": "0.06em", "margin-bottom": "{space.tight}" } },
    { "name": "lists", "selectors": ["#output ul", "#output ol"], "declarations": { "color": "{color.ink}", "line-height": "{line.body}", "margin": "0 {space.gutter} {space.block}", "padding-left": "28px" } },
    { "name": "list-item", "selectors": ["#output li"], "declarations": { "border-bottom": "1px dotted {color.border}", "margin": "5px 0", "padding": "0 0 5px 5px" } },
    { "name": "table", "selectors": ["#output table"], "declarations": { "background-color": "{color.surface}", "border": "2px solid {color.primaryDark}", "border-collapse": "collapse", "color": "{color.ink}", "font-size": "{size.small}", "margin": "{space.block} 0", "width": "100%" } },
    { "name": "table-head", "selectors": ["#output thead"], "declarations": { "background-color": "{color.primaryDark}", "color": "{color.white}" } },
    { "name": "table-header-cell", "selectors": ["#output th"], "declarations": { "background-color": "{color.primaryDark}", "border": "1px solid {color.soft}", "color": "{color.white}", "font-family": "{font.heading}", "font-weight": "700", "letter-spacing": "0.04em", "line-height": "1.5", "padding": "{space.tight}", "text-align": "left" } },
    { "name": "table-cell", "selectors": ["#output td"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.border}", "line-height": "1.65", "padding": "{space.tight}", "vertical-align": "top" } },
    { "name": "table-alt-row", "selectors": ["#output tbody tr:nth-child(even) td"], "declarations": { "background-color": "{color.soft}" } },
    { "name": "code-block", "selectors": ["#output pre", "#output pre.code__pre", "#output .code-block"], "declarations": { "background-color": "{color.codeBackground}", "border-bottom": "4px solid {color.accent}", "border-left": "5px solid {color.primary}", "border-radius": "{radius.medium}", "color": "{color.codeText}", "font-family": "{font.mono}", "font-size": "{size.code}", "line-height": "{line.code}", "margin": "{space.block} {space.gutter}", "overflow-wrap": "anywhere", "padding": "{space.card}", "white-space": "pre-wrap", "word-break": "break-word" } },
    { "name": "code-block-inner", "selectors": ["#output pre code", "#output pre.code__pre code"], "declarations": { "background-color": "transparent", "border": "0", "color": "inherit", "display": "block", "font-family": "{font.mono}", "margin": "0", "padding": "0", "white-space": "inherit" } },
    { "name": "code-inline", "selectors": ["#output code", "#output .codespan", "#output .code-inline"], "declarations": { "background-color": "{color.soft}", "border": "1px solid {color.border}", "border-radius": "{radius.small}", "color": "{color.primaryDark}", "font-family": "{font.mono}", "font-size": "{size.code}", "padding": "2px 5px" } },
    { "name": "image", "selectors": ["#output img"], "declarations": { "border": "1px solid {color.border}", "border-radius": "{radius.small}", "box-shadow": "{shadow.card}", "display": "block", "height": "auto", "margin": "{space.block} auto", "max-width": "100%", "padding": "4px" } },
    { "name": "figure", "selectors": ["#output figure"], "declarations": { "border-bottom": "1px solid {color.border}", "margin": "{space.block} {space.gutter}", "padding": "0 0 {space.tight}" } },
    { "name": "figcaption", "selectors": ["#output figcaption", "#output .md-figcaption"], "declarations": { "color": "{color.muted}", "font-family": "{font.heading}", "font-size": "{size.small}", "font-style": "italic", "line-height": "1.5", "margin-top": "8px", "text-align": "center" } },
    { "name": "divider", "selectors": ["#output hr"], "declarations": { "background-color": "transparent", "border": "0", "border-top": "4px double {color.primary}", "height": "0", "margin": "{space.block} {space.gutter}" } },
    { "name": "card", "selectors": ["#output .wechat-card"], "declarations": { "background-color": "{color.surface}", "border": "1px solid {color.primary}", "border-radius": "{radius.large}", "border-top": "6px double {color.primary}", "box-shadow": "{shadow.card}", "margin": "{space.block} {space.gutter}", "padding": "{space.card}" } },
    { "name": "card-title", "selectors": ["#output .wechat-card-title"], "declarations": { "border-bottom": "2px solid {color.accent}", "color": "{color.primaryDark}", "font-family": "{font.heading}", "font-size": "{size.h3}", "font-weight": "700", "letter-spacing": "0.08em", "margin-bottom": "{space.tight}", "padding-bottom": "{space.tight}" } },
    { "name": "note", "selectors": ["#output .wechat-note", "#output .footnotes"], "declarations": { "background-color": "{color.soft}", "border": "1px dashed {color.accent}", "border-radius": "{radius.small}", "color": "{color.muted}", "font-size": "{size.small}", "line-height": "1.65", "margin": "{space.block} {space.gutter}", "padding": "{space.tight}" } },
    { "name": "highlight", "selectors": ["#output mark", "#output .markup-highlight"], "declarations": { "background-color": "{color.highlight}", "border-bottom": "1px solid {color.accent}", "border-radius": "{radius.small}", "color": "{color.ink}", "font-weight": "700", "padding": "2px 4px" } },
    { "name": "underline", "selectors": ["#output .markup-underline"], "declarations": { "color": "{color.primaryDark}", "text-decoration": "underline", "text-decoration-color": "{color.primary}", "text-underline-offset": "4px" } }
  ]
}
